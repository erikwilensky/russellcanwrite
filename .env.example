# The 8-digit code that opens the game. Required in production (no code = nobody can sign in). Local dev default: 00000000.
# Changing it signs out every device.
RCW_ACCESS_CODE=""
# Optional second code for a guest such as Russell's teacher: every task open, nothing saved, no AI.
# Leave empty to turn guest access off. Local dev default: 11111111.
RCW_GUEST_CODE=""
# Long random string used to sign the login cookie. Required in production.
AUTH_SECRET=""
# Where Russell's save file is kept (a JSON file). Defaults to ./data. Back this folder up.
DATA_DIR="./data"
# Optional: turns on the AI writing coach. Without it, paragraphs are marked by the built-in rules.
OPENAI_API_KEY=""
# Optional: defaults to gpt-4o-mini.
OPENAI_MODEL=""
# Spend cap for the AI coach in US dollars per calendar month (Bangkok time). Default 10.
# When reached, paragraphs are marked by the built-in rules until the next month.
AI_MONTHLY_LIMIT_USD=10
# Most AI coach calls per day. Default 60.
AI_DAILY_CALL_LIMIT=60
# Port for `npm start` (Next.js reads PORT).
PORT=3000
# (In Docker, PORT=3000 and DATA_DIR=/data are already set by the image.)
