# The 8-digit code that opens the game (defaults to the one Erik chose if unset).
# Changing it signs out every device.
RCW_ACCESS_CODE=""
# Long random string used to sign the login cookie. Required in production.
AUTH_SECRET=""
# Where Russell's save file is kept (a JSON file). Defaults to ./data. Back this folder up.
DATA_DIR="./data"
# Optional: turns on the AI writing coach. Without it, paragraphs are marked by the built-in rules.
OPENAI_API_KEY=""
# Optional: defaults to gpt-4o-mini.
OPENAI_MODEL=""
# Port for `npm start` (Next.js reads PORT).
PORT=3000
